@{ ViewData["Title"] = "Account ready"; var setupSkipped = ViewBag.AuthenticatorSetupSkipped is true; }
<section class="verification-complete">
    <div class="verification-check" aria-hidden="true">✓</div>
    @if (setupSkipped)
    {
        <p class="eyebrow">ACCOUNT CREATED</p>
        <h1>Your account is ready.</h1>
        <p>Authenticator setup is optional. Your employee account is ready. Choose the relevant department when you submit each idea.</p>
    }
    else
    {
        <p class="eyebrow">ACCOUNT READY</p>
        <h1>Your account is ready.</h1>
        <p>Your employee account is ready. Choose the relevant department when you submit each idea.</p>
    }
    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">Continue to sign in</a>
</section>
