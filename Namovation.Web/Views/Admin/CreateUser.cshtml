@model Namovation.Web.Models.AdminCreateUserInput
@{ ViewData["Title"] = "Create user"; var roles = new[] { "Employee", "InnovateManager", "InnovateBoard", "Admin" }; }
<a asp-action="Users" class="small">← User accounts and roles</a>
<h1 class="mt-3">Create user</h1>
<p class="text-secondary">The account and selected role memberships will be saved to the database. Set an initial password and share it with the user securely.</p>
<form asp-action="CreateUser" method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="off"/><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="DisplayName" class="form-label">Full name</label><input asp-for="DisplayName" class="form-control"/><span asp-validation-for="DisplayName" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Designation" class="form-label">Designation</label><input asp-for="Designation" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control"/></div></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Initial password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <fieldset class="mb-4"><legend class="form-label">Assign roles</legend><div class="admin-role-options">@foreach (var role in roles) { <label><input type="checkbox" name="Roles" value="@role" checked="@Model.Roles.Contains(role)"/> @role</label> }</div><span asp-validation-for="Roles" class="text-danger"></span></fieldset>
    <button class="btn btn-primary">Create account</button> <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
