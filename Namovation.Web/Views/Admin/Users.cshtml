@model IReadOnlyList<Namovation.Web.Models.AdminUserRow>
@{ ViewData["Title"] = "User roles"; var roles = new[] { "Employee", "InnovateManager", "InnovateBoard", "Admin" }; }
<div class="page-heading"><div><h1>User accounts and roles</h1><p class="text-secondary">Review registered accounts and assign application access.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Departments" class="btn btn-outline-primary">Manage departments</a><a asp-action="RegistrationSettings" class="btn btn-outline-primary">Registration settings</a></div></div>
<p class="text-secondary">Users register their own accounts and receive the Employee role. To make someone a manager or board member, have them register, select their role here, and save. Role changes take effect after that user signs out and signs in again. Create departments and connect each department to one manager in Manage departments.</p>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Count == 0) { <div class="empty-state"><h2>No accounts yet</h2><p>Users will appear here after they register.</p></div> }
else {
    <div class="admin-user-list">
    @foreach (var user in Model) {
        <form asp-action="SetRoles" method="post" class="card admin-user-row">
            <input type="hidden" name="userId" value="@user.UserId" />
            <div class="admin-user-identity"><strong>@user.Email</strong><span>@(string.IsNullOrWhiteSpace(user.DisplayName) ? "Name not set" : user.DisplayName)</span><small>@(user.Designation ?? "") @if (!string.IsNullOrWhiteSpace(user.Location)) { <text>· @user.Location</text> }</small></div>
            <div class="admin-role-options">
                @foreach (var role in roles) {
                    <label><input type="checkbox" name="roles" value="@role" checked="@user.Roles.Contains(role)" /> @role</label>
                }
            </div>
            <button class="btn btn-sm btn-primary" type="submit">Save roles</button>
        </form>
    }
    </div>
}
