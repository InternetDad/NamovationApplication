@model Namovation.Web.Models.HomeDashboardModel
@{ ViewData["Title"] = Model.IsAuthenticated ? "Dashboard" : "Welcome"; }

@if (Model.IsAuthenticated)
{
    <section class="dashboard-welcome mb-4">
        <div>
            @if (Model.AuthenticatorSetupPending)
            {
                <p class="eyebrow">FINISH ACCOUNT SETUP</p>
                <h1>One last security step, @Model.DisplayName.</h1>
                <p class="lead mb-0">Connect an authenticator app to unlock your employee workspace.</p>
            }
            else
            {
                <p class="eyebrow">YOUR INNOVATION WORKSPACE</p>
                <h1>Welcome back, @Model.DisplayName</h1>
                <p class="lead mb-0">A clear view of the work waiting for you.</p>
            }
        </div>
        @if (User.IsInRole("Employee")) { <a class="btn btn-primary" asp-controller="Workflow" asp-action="Submit">+ Submit an idea</a> }
    </section>

    @if (Model.Metrics.Count > 0)
    {
        <section class="dashboard-metrics mb-5" aria-label="Your work at a glance">
            @foreach (var metric in Model.Metrics)
            {
                <article class="metric-card"><span>@metric.Label</span><strong>@metric.Value</strong><small>@metric.Detail</small></article>
            }
        </section>
    }

    <section class="mb-5">
        <div class="section-heading"><div><p class="eyebrow">QUICK ACCESS</p><h2>Go to your workspace</h2></div></div>
        <div class="row g-3">
            @foreach (var shortcut in Model.Shortcuts)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="card dashboard-action h-100">
                        <div class="card-body">
                            <span class="action-mark" aria-hidden="true">↗</span>
                            <h3>@shortcut.Title</h3>
                            <p>@shortcut.Description</p>
                            <a class="btn btn-outline-primary mt-auto" asp-controller="@shortcut.Controller" asp-action="@shortcut.Action">@shortcut.ButtonText</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
    <aside class="dashboard-note"><strong>One idea at a time can improve how we work.</strong><span>Your submissions and role-specific tasks are available from the navigation above.</span></aside>
}
else
{
    <section class="hero hero-home mb-4">
        <div class="hero-copy">
            <p class="eyebrow">EMPLOYEE INNOVATION PORTAL</p>
            <h1>Good ideas deserve a clear path.</h1>
            <p class="lead">Share an idea, follow its progress, and help improve how we work.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
                @if (Model.ShowFirstAdminSetup) { <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="SetupFirstAdmin">Create first administrator</a> }
            </div>
        </div>
        <div class="hero-steps" aria-label="How Namovation works">
            <div><span>01</span><strong>Share</strong><small>Submit an improvement idea</small></div>
            <div><span>02</span><strong>Review</strong><small>Managers and board evaluate it</small></div>
            <div><span>03</span><strong>Recognize</strong><small>Track decisions and outcomes</small></div>
        </div>
    </section>

    <section class="public-process row g-3 mb-5" aria-label="The idea process">
        <div class="col-md-4"><article class="card h-100"><div class="card-body"><span class="step">01</span><h2>Share</h2><p>Submit process, product, or customer-experience ideas and follow their progress.</p></div></article></div>
        <div class="col-md-4"><article class="card h-100"><div class="card-body"><span class="step">02</span><h2>Review</h2><p>The manager screens submissions and prepares anonymized monthly board reviews.</p></div></article></div>
        <div class="col-md-4"><article class="card h-100"><div class="card-body"><span class="step">03</span><h2>Learn</h2><p>Evaluations and meeting outcomes are recorded with a traceable history.</p></div></article></div>
    </section>
}
