<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f8f6" />
    <title>@ViewData["Title"] - Namovation</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Namovation.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-xl">
                <a class="navbar-brand brand-lockup" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">N</span>
                    <span><strong>Namovation</strong><small>Ideas into impact</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-lg-5 me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        @if (User.IsInRole("Employee")) { <li class="nav-item"><a class="nav-link" asp-controller="Workflow" asp-action="Mine">My ideas</a></li><li class="nav-item"><a class="nav-link" asp-controller="Workflow" asp-action="Submit">Submit an idea</a></li> }
                        @if (User.IsInRole("InnovateManager")) { <li class="nav-item"><a class="nav-link" asp-controller="Workflow" asp-action="Manager">Manager workspace</a></li> }
                        @if (User.IsInRole("InnovateBoard")) { <li class="nav-item"><a class="nav-link" asp-controller="Workflow" asp-action="Board">Board reviews</a></li> }
                        @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">User management</a></li><li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="RegistrationSettings">Settings</a></li> }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main class="container-xl app-main" role="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container-xl"><span>Namovation</span><span>Every improvement starts with an idea.</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
