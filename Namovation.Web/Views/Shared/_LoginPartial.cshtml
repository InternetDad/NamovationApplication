@using Namovation.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<NamovationUser> SignInManager
@if (SignInManager.IsSignedIn(User)) {
    <div class="account-actions"><span class="account-label"><span class="account-dot"></span>@User.Identity?.Name</span><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="btn btn-sm btn-outline-secondary">Sign out</button></form></div>
} else {
    <div class="account-actions"><a class="nav-link" asp-controller="Account" asp-action="Register">Create account</a><a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Sign in</a></div>
}
