@using Namovation.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<NamovationUser> SignInManager
@if (SignInManager.IsSignedIn(User)) {
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><span class="navbar-text me-2">@User.Identity?.Name</span><button class="btn btn-sm btn-outline-secondary">Sign out</button></form>
} else {
    <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
}
