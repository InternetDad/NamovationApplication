@model IReadOnlyList<Namovation.Web.Models.BoardIdeaRow>
@{ ViewData["Title"] = "Board evaluations"; }
<h1>Board evaluations</h1><p class="text-secondary">Score each shortlisted idea independently. Only its system reference and idea details are shown here.</p>
@if (TempData["Message"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
@if (Model.Count == 0) { <div class="empty-state"><h2>No ideas are awaiting evaluation</h2><p>New ideas will appear after the manager forwards a monthly compilation.</p></div> }
@foreach (var idea in Model) { <article class="card idea-card mb-3"><div class="card-body"><div class="eyebrow">@idea.ReferenceNumber</div><h2>@idea.Title</h2><p>@idea.Description</p>@if (idea.Evaluated) { <div class="alert alert-success mb-0">Your evaluation has been submitted.</div> } else { <form asp-action="Evaluate" method="post" class="score-form"><input type="hidden" name="IdeaId" value="@idea.Id"/>@foreach (var parameter in new[] { ("Novelty", "Novelty"), ("Feasibility", "Feasibility"), ("Relevance", "Relevance"), ("BusinessImpact", "Business impact"), ("CommercialViability", "Commercial viability") }) { <label>@parameter.Item2 <select name="@parameter.Item1" class="form-select" required>@for (int n = 1; n <= 10; n++) { <option value="@n" selected="@(n == 5)">@n</option> }</select></label> }<button class="btn btn-primary">Submit evaluation</button></form> }</div></article> }
