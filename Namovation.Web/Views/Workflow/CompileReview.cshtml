@model Namovation.Web.Models.CompilationReview
@{ ViewData["Title"] = "Review board scores"; var averages = new double[] { Model.Scores.Average(x => x.Novelty), Model.Scores.Average(x => x.Feasibility), Model.Scores.Average(x => x.Relevance), Model.Scores.Average(x => x.BusinessImpact), Model.Scores.Average(x => x.CommercialViability) }; var averageTotal = Model.Scores.Average(x => x.Total); }
<a asp-action="Manager" class="small">← Manager workspace</a><h1 class="mt-3">Compile board scores</h1><p class="text-secondary">@Model.Idea.ReferenceNumber · @Model.Idea.Title</p>
<div class="table-responsive card mb-4"><table class="table align-middle mb-0"><thead><tr><th>Board member</th><th>Novelty</th><th>Feasibility</th><th>Relevance</th><th>Business impact</th><th>Commercial viability</th><th>Total</th></tr></thead><tbody>@foreach (var score in Model.Scores) { <tr><td>@score.BoardMember</td><td>@score.Novelty</td><td>@score.Feasibility</td><td>@score.Relevance</td><td>@score.BusinessImpact</td><td>@score.CommercialViability</td><td><strong>@score.Total/50</strong></td></tr> }<tr class="table-light"><th>Average</th>@foreach (var average in averages) { <td>@average.ToString("0.00")</td> }<td><strong>@averageTotal.ToString("0.00")/50</strong></td></tr></tbody></table></div>
<p>Reward consideration threshold: <strong>40/50</strong>. A qualifying average proceeds to the meeting decision; it does not automatically approve a reward.</p>
<form asp-action="Compile" method="post"><input type="hidden" name="id" value="@Model.Idea.Id"/><button class="btn btn-primary">Save compilation</button> <a asp-action="Manager" class="btn btn-outline-secondary">Cancel</a></form>
