@model Namovation.Web.Models.ManagerPage
@{ ViewData["Title"] = "Manager workspace"; }
<div class="page-heading"><div><h1>Manager workspace</h1><p class="text-secondary">Screen submissions, forward the monthly shortlist, compile completed evaluations, and record meeting outcomes.</p></div></div>
@if (TempData["Message"] is string msg) { <div class="alert alert-success">@msg</div> } @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
<section class="mb-5"><h2>New submissions <span class="counter">@Model.Pending.Count</span></h2>
    @if (Model.Pending.Count == 0) { <p class="text-secondary">No ideas are waiting for screening.</p> }
    @if (Model.Pending.Count > 0) {
        <div class="table-responsive card manager-submission-grid">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Reference</th><th>Employee</th><th>Idea</th><th>Submitted</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                <tbody>
                @foreach (var idea in Model.Pending) {
                    <tr>
                        <td class="text-nowrap">@idea.ReferenceNumber</td>
                        <td>@idea.Submitter</td>
                        <td class="manager-grid-title">@idea.Title</td>
                        <td class="text-nowrap">@idea.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td><span class="badge text-bg-light">Submitted</span></td>
                        <td class="text-end"><button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#screenIdea-@idea.Id">Review idea</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @foreach (var idea in Model.Pending) {
            <div class="modal fade" id="screenIdea-@idea.Id" tabindex="-1" aria-labelledby="screenIdeaLabel-@idea.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div><div class="eyebrow">@idea.ReferenceNumber · @idea.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</div><h2 class="modal-title fs-4 mt-2 mb-0" id="screenIdeaLabel-@idea.Id">@idea.Title</h2></div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <dl class="row idea-detail-list">
                                <dt class="col-sm-4">Submitted by</dt><dd class="col-sm-8">@idea.Submitter</dd>
                                @if (!string.IsNullOrWhiteSpace(idea.ProblemStatement)) { <dt class="col-sm-4">Problem or opportunity</dt><dd class="col-sm-8 text-prewrap">@idea.ProblemStatement</dd> }
                                <dt class="col-sm-4">Idea details</dt><dd class="col-sm-8 text-prewrap">@idea.Description</dd>
                                @if (!string.IsNullOrWhiteSpace(idea.ProposedBenefit)) { <dt class="col-sm-4">Expected benefit</dt><dd class="col-sm-8 text-prewrap">@idea.ProposedBenefit</dd> }
                                @if (idea.AttachmentId is int attachmentId) { <dt class="col-sm-4">Supporting document</dt><dd class="col-sm-8"><a class="btn btn-sm btn-outline-primary" asp-action="SupportingDocument" asp-route-id="@attachmentId">Download attachment</a><span class="small text-secondary ms-2">Private to the employee and manager; not available to the board.</span></dd> }
                            </dl>
                            <hr />
                            <form asp-action="Screen" method="post" id="screenForm-@idea.Id">
                                <input type="hidden" name="id" value="@idea.Id" />
                                <h3 class="h5">Manager screening</h3>
                                <p class="text-secondary small">To shortlist, remove employee names, locations, and other identifying details from the title and description that the board will see. Shortlisted ideas join the monthly compilation for board evaluation.</p>
                                <label class="form-label" for="boardTitle-@idea.Id">Anonymized title for board</label>
                                <input id="boardTitle-@idea.Id" name="boardTitle" class="form-control mb-3" placeholder="Remove identifying details" />
                                <label class="form-label" for="boardDescription-@idea.Id">Anonymized description for board</label>
                                <textarea id="boardDescription-@idea.Id" name="boardDescription" class="form-control mb-3" rows="4" placeholder="Anonymized version for board review"></textarea>
                                <label class="form-label" for="screeningNote-@idea.Id">Screening note (optional)</label>
                                <input id="screeningNote-@idea.Id" name="rationale" class="form-control" placeholder="Add a note for the screening record" />
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="screenForm-@idea.Id" name="shortlist" value="false" class="btn btn-outline-secondary">File in Repository 1</button>
                            <button type="submit" form="screenForm-@idea.Id" name="shortlist" value="true" class="btn btn-primary">Shortlist for monthly compilation</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</section>
@if (Model.PendingAddenda.Count > 0) {
<section class="mb-5"><h2>Shortlisted addenda awaiting your approval <span class="counter">@Model.PendingAddenda.Count</span></h2>
    <p class="text-secondary">These ideas belong to a monthly compilation that was already forwarded. Review them here, then use that month’s “Forward addendum” action below to send them to the board.</p>
    <div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Reference</th><th>Idea</th><th>Submitted</th><th>Status</th></tr></thead><tbody>
    @foreach (var idea in Model.PendingAddenda) { <tr><td class="text-nowrap">@idea.ReferenceNumber</td><td>@idea.Title</td><td class="text-nowrap">@idea.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge text-bg-light">Waiting for manager to forward</span></td></tr> }
    </tbody></table></div>
</section>
}
<section class="mb-5"><h2>Monthly compilations</h2><div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Period</th><th>Shortlisted ideas</th><th>Board status</th><th></th></tr></thead><tbody>
@foreach (var batch in Model.Months) {
    var pendingAddenda = batch.Ideas.Count(i => i.Status == Namovation.Domain.IdeaStatus.Shortlisted);
    var canForward = batch.Ideas.Count > 0 && (!batch.ForwardedToBoard || pendingAddenda > 0);
    <tr>
        <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(batch.Month) @batch.Year</td>
        <td>@batch.Ideas.Count</td>
        <td>@(batch.ForwardedToBoard ? $"Forwarded{(pendingAddenda > 0 ? $" · {pendingAddenda} addendum(s) waiting" : "")}" : "Preparing")</td>
        <td>@if (canForward) { <form asp-controller="Workflow" asp-action="Forward" method="post" asp-antiforgery="true"><input type="hidden" name="year" value="@batch.Year"/><input type="hidden" name="month" value="@batch.Month"/><button type="submit" class="btn btn-sm btn-outline-primary">@(batch.ForwardedToBoard ? "Forward addendum" : "Forward to board")</button></form> }</td>
    </tr>
}
</tbody></table></div><p class="small text-secondary mt-2">Shortlists are grouped by the month an idea was submitted. Forward each monthly compilation manually; ideas added after forwarding wait for a separate addendum action.</p></section>
<section class="mb-5"><h2>Board evaluation in progress <span class="counter">@Model.AwaitingBoardEvaluation.Count</span></h2>
    <p class="text-secondary">Forwarded ideas stay here while board members submit their independent scores. They move to “Ready to compile” after all three evaluations are received.</p>
    @if (Model.AwaitingBoardEvaluation.Count == 0) { <p class="text-secondary">No forwarded ideas are waiting for board evaluations.</p> }
    @if (Model.AwaitingBoardEvaluation.Count > 0) {
        <div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Reference</th><th>Idea</th><th>Submitted</th><th>Board evaluations</th><th>Status</th></tr></thead><tbody>
        @foreach (var idea in Model.AwaitingBoardEvaluation) { <tr><td class="text-nowrap">@idea.ReferenceNumber</td><td>@idea.Title</td><td class="text-nowrap">@idea.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><strong>@idea.EvaluationCount / @Namovation.Domain.EvaluationRules.RequiredBoardMembers</strong></td><td><span class="badge text-bg-light">Forwarded to board</span></td></tr> }
        </tbody></table></div>
    }
</section>
<section class="mb-5"><h2>Ready to compile <span class="counter">@Model.ReadyToCompile.Count</span></h2>
    @if (Model.ReadyToCompile.Count == 0) { <p class="text-secondary">An idea appears here when three board members have submitted their scores.</p> }
    <div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th>Idea</th><th>Scores</th><th></th></tr></thead><tbody>@foreach (var idea in Model.ReadyToCompile) { <tr><td>@idea.ReferenceNumber</td><td>@idea.Title</td><td>@idea.EvaluationCount / 3</td><td><a class="btn btn-sm btn-primary" asp-action="CompileReview" asp-route-id="@idea.Id">Review scores</a></td></tr> }</tbody></table></div>
</section>
<section class="mb-5"><h2>Reward meeting decisions</h2><p class="text-secondary">Only ideas averaging at least 40/50 are eligible for the meeting decision. Qualification does not automatically approve a reward.</p>
@foreach (var idea in Model.Repositories.Where(x => x.RewardEligible == true && x.RewardOutcome == Namovation.Domain.RewardOutcome.Pending)) { <article class="card mb-3"><div class="card-body"><div class="eyebrow">@idea.ReferenceNumber · @idea.AverageTotal/50</div><h3>@idea.Title</h3><p>@idea.Description</p><form asp-action="RewardDecision" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="id" value="@idea.Id"/><select name="outcome" class="form-select decision"><option value="Rewarded">Reward</option><option value="Appreciated">Appreciation</option><option value="NotSelected">Not selected</option></select><input name="notes" class="form-control rationale" placeholder="Meeting notes (optional)"/><button class="btn btn-primary">Record decision</button></form></div></article> }
</section>
<section class="mb-5"><h2>Repositories</h2><div class="row g-3">
@for (var n = 1; n <= 3; n++) {
    var matches = Model.Repositories.Where(x => (int?)x.Repository == n).ToList();
    var label = n == 1 ? "Not selected for board evaluation." : n == 2 ? "Board-evaluated and below the reward consideration threshold." : "Finally selected for reward or appreciation.";
    <div class="col-md-4"><article class="card repository-card h-100"><div class="card-body"><div class="repository-card-top"><span class="repository-number">0@n</span><span class="counter">@matches.Count ideas</span></div><h3>Repository @n</h3><p class="text-secondary">@label</p><button type="button" class="btn btn-outline-primary mt-auto" data-bs-toggle="modal" data-bs-target="#repositoryDetails-@n" disabled="@(matches.Count == 0)">View ideas</button></div></article></div>
    @if (matches.Count > 0) {
        var outcomeHeading = n == 1 ? "Screening result" : n == 2 ? "Threshold result" : "Meeting outcome";
        <div class="modal fade" id="repositoryDetails-@n" tabindex="-1" aria-labelledby="repositoryDetailsLabel-@n" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header"><div><p class="eyebrow mb-1">IDEA ARCHIVE · @matches.Count ITEMS</p><h2 class="modal-title fs-4 mb-0" id="repositoryDetailsLabel-@n">Repository @n</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <div class="table-responsive repository-details-grid"><table class="table table-hover align-middle"><thead><tr><th>Reference</th><th>Idea and details</th><th>Submitted by</th><th>Submitted</th><th>Score</th><th>@outcomeHeading</th><th>Document</th></tr></thead><tbody>
                        @foreach (var item in matches) {
                            var score = n == 1 ? "Not evaluated" : item.AverageTotal.HasValue ? $"{item.AverageTotal:0.00}/50" : "—";
                            var outcome = n == 1 ? "Not shortlisted" : n == 2 ? "Below 40/50" : item.RewardOutcome?.ToString() ?? "—";
                            <tr><td class="text-nowrap">@item.ReferenceNumber</td><td class="repository-idea-cell"><strong>@item.Title</strong><p>@item.Description</p>@if (!string.IsNullOrWhiteSpace(item.ProposedBenefit)) { <small><b>Expected benefit:</b> @item.ProposedBenefit</small> }</td><td>@item.Submitter</td><td class="text-nowrap">@item.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-nowrap">@score</td><td>@outcome</td><td>@if (item.AttachmentId is int attachmentId) { <a class="btn btn-sm btn-outline-primary" asp-action="SupportingDocument" asp-route-id="@attachmentId">Download</a> } else { <span class="text-secondary">—</span> }</td></tr>
                        }
                        </tbody></table></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>
                </div>
            </div>
        </div>
    }
}
</div></section>
