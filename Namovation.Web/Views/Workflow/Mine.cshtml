@model IReadOnlyList<Namovation.Web.Models.IdeaRow>
@{ ViewData["Title"] = "My ideas"; }
<div class="page-heading"><div><h1>My ideas</h1><p class="text-secondary">Follow screening, evaluation, and reward status.</p></div><a class="btn btn-primary" asp-action="Submit">+ Submit an idea</a></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
@if (Model.Count == 0) { <div class="empty-state"><h2>Your first idea starts here</h2><p>Share an improvement for a process, product, or customer experience.</p><a asp-action="Submit" class="btn btn-primary">Submit an idea</a></div> }
else { <div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th>Idea</th><th>Department</th><th>Submitted</th><th>Status</th><th>Evaluation</th><th>Document</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ReferenceNumber</td><td>@item.Title</td><td>@(item.DepartmentName ?? "Legacy submission")</td><td>@item.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge rounded-pill text-bg-light">@item.Status</span>@if (item.RewardEligible == true && item.RewardOutcome == Namovation.Domain.RewardOutcome.Pending) { <div class="small text-secondary">Eligible; meeting decision pending</div> }</td><td>@(item.AverageTotal.HasValue ? $"{item.AverageTotal:0.00}/50" : "In progress") @if (item.RewardOutcome is Namovation.Domain.RewardOutcome.Rewarded or Namovation.Domain.RewardOutcome.Appreciated) { <span>· @item.RewardOutcome</span> }</td><td>@if (item.AttachmentId is int attachmentId) { <a class="btn btn-sm btn-outline-primary" asp-action="SupportingDocument" asp-route-id="@attachmentId">Download</a> } else { <span class="text-secondary">—</span> }</td></tr> }</tbody></table></div> }
